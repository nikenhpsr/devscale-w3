model Videos {
  id         String      @id @default(uuid())
  youtubeUrl String
  youtubeId  String
  title      String
  createdAt  DateTime @default(now())
  summaries  Summaries[]
  jobs       Jobs[]
}

model Summaries {
  id        String   @id @default(uuid())
  videoId   String
  video     Videos   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([videoId])
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Jobs {
  id           String    @id @default(uuid())
  videoId      String
  video        Videos    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  status       JobStatus @default(PENDING)
  errorMessage String?
  createdAt    DateTime @default(now())
  completedAt  DateTime?

  @@index([videoId])
}

model AgentMemorySession {
  id              String @id @default(cuid(2))
  scopeKey        String @unique
  sessionId       String
  userId          String?
  metadata        Jsonb
  compactionState Jsonb?
  createdAt       TimestampString(3) @default(now())
  updatedAt       TimestampString(3)

  messages AgentMemoryMessage[]
  errors   AgentMemoryError[]

  @@index([sessionId, userId])
  @@map("AgentMemorySession")
}

model AgentMemoryMessage {
  id              String @id @default(cuid(2))
  memorySessionId String
  memorySession   AgentMemorySession @relation(fields: [memorySessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  runId           String
  turn            Int
  position        Int
  role            String
  message         Jsonb
  createdAt       TimestampString(3) @default(now())

  @@unique([memorySessionId, position])
  @@index([runId])
  @@map("AgentMemoryMessage")
}

model AgentMemoryError {
  id              String @id @default(cuid(2))
  memorySessionId String
  memorySession   AgentMemorySession @relation(fields: [memorySessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  runId           String
  error           Jsonb
  messages        Jsonb
  createdAt       TimestampString(3) @default(now())

  @@index([runId])
  @@map("AgentMemoryError")
}